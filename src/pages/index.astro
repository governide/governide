---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import Hero from '../components/Hero.astro';
import Statistics from '../components/Statistics.astro';
import Technology from '../components/Technology.astro';
import Services from '../components/Services.astro';
import WhyGovernIDE from '../components/WhyGovernIDE.astro';
import About from '../components/about.astro';
import Industries from '../components/Industries.astro';
import Training from '../components/Training.astro';
import Timeline from '../components/Timeline.astro';
import Testimonials from '../components/Testimonials.astro';
import Resources from '../components/Resources.astro';
import CTA from '../components/CTA.astro';

import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body class="antialiased bg-gray-50 text-gray-800">

    <Navbar />

    <main>

      <!-- Hero -->
      <Hero />

      <!-- Trust Metrics -->
      <Statistics />

      <!-- Technologies -->
      <Technology />

      <!-- Core Services -->
      <Services />

      <!-- Why Choose GovernIDE -->
      <WhyGovernIDE />

      <!-- About -->
      <About />

      <!-- Industries -->
      <Industries />

      <!-- Training -->
      <Training />

      <!-- Delivery Process -->
      <Timeline />

      <!-- Client Success -->
      <Testimonials />

      <!-- Resources & Insights -->
      <Resources />

      <!-- Call To Action -->
      <CTA>
        <h3 class="text-3xl font-bold text-white">
          Ready to Strengthen Your Identity Security?
        </h3>

        <p class="mt-5 text-lg text-white/90 max-w-2xl mx-auto">
          Whether you're implementing SailPoint, modernising Identity Governance,
          or building your IAM capability, GovernIDE can help you design,
          deliver and optimise secure enterprise identity solutions.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-4">

          <a
            href="/contact"
            class="rounded-full bg-white px-7 py-3 font-semibold text-gov-dark transition hover:scale-105"
          >
            Book a Consultation
          </a>

          <a
            href="#training"
            class="rounded-full border border-white/30 px-7 py-3 font-semibold text-white transition hover:bg-white hover:text-gov-dark"
          >
            Explore Training
          </a>

        </div>
      </CTA>

    </main>

    <Footer />

  </body>
</html>