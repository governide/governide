---
---
import { SITE_TITLE } from '../consts';
---

<header class="sticky top-0 z-40 backdrop-blur-sm bg-white/60 border-b border-white/5">
  <div class="container mx-auto px-4">
    <nav class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-3 text-gov-dark font-semibold">
        <span class="w-10 h-10 rounded-lg bg-gradient-to-br from-gov-purple to-gov-blue flex items-center justify-center text-white shadow-md">G</span>
        <span class="sr-only">GovernIDE</span>
        <span class="ml-2 text-lg">{SITE_TITLE}</span>
      </a>

      <ul class="hidden md:flex items-center gap-6 text-sm text-gray-600">
        <li><a href="#home" class="hover:text-gov-blue">Home</a></li>
        <li><a href="#services" class="hover:text-gov-blue">Services</a></li>
        <li><a href="#training" class="hover:text-gov-blue">Training</a></li>
        <li><a href="#resources" class="hover:text-gov-blue">Resources</a></li>
        <li><a href="#about" class="hover:text-gov-blue">About</a></li>
        <li><a href="#contact" class="hover:text-gov-blue">Contact</a></li>
      </ul>

      <div class="flex items-center gap-3">
        <a href="/contact" class="hidden md:inline-block px-4 py-2 rounded-full bg-gov-dark text-white text-sm">Book Consultation</a>
        <button class="md:hidden p-2 rounded-lg bg-white/50 border border-white/5">Menu</button>
      </div>
    </nav>
  </div>
</header>
