---

<section class="hero">

  <div class="container hero-grid">

    <div class="hero-left">

      <span class="badge">
        Enterprise Identity Governance
      </span>

      <h1>
        Secure Digital <br />
        <span>Identities</span> for <br />
        Modern Enterprises
      </h1>

      <p>
        GovernIDE helps organisations modernise Identity Governance,
        SailPoint implementations, Identity Lifecycle Management,
        Access Governance and Enterprise IAM through consulting,
        architecture and hands-on training.
      </p>

      <div class="hero-buttons">

        <a href="#contact" class="btn btn-primary">
          Book Consultation
        </a>

        <a href="#training" class="btn hero-outline">
          Explore Training
        </a>

      </div>

      <div class="hero-stats">

        <div>
          <h3>14+</h3>
          <p>Years Experience</p>
        </div>

        <div>
          <h3>50+</h3>
          <p>Projects Delivered</p>
        </div>

        <div>
          <h3>100+</h3>
          <p>Professionals Mentored</p>
        </div>

      </div>

    </div>

    <div class="hero-right">

      <div class="feature-card">

        <h2>Identity Governance</h2>

        <ul>

          <li>✔ SailPoint ISC</li>
          <li>✔ SailPoint IdentityIQ</li>
          <li>✔ Identity Lifecycle</li>
          <li>✔ Access Reviews</li>
          <li>✔ Certifications</li>
          <li>✔ RBAC</li>

        </ul>

        <a href="#services" class="learn">
          Explore Services →
        </a>

      </div>

    </div>

  </div>

</section>

<style>

.hero{

padding:110px 0;

background:
radial-gradient(circle at top right,
rgba(56,189,248,.15),
transparent 35%),

linear-gradient(
135deg,
#071B3D,
#153E91
);

}

.hero-grid{

display:grid;

grid-template-columns:1.15fr .85fr;

gap:70px;

align-items:center;

}

.badge{

display:inline-block;

background:rgba(255,255,255,.12);

padding:12px 22px;

border-radius:999px;

color:white;

font-weight:600;

margin-bottom:30px;

}

.hero h1{

color:white;

font-size:clamp(3.8rem,6vw,5.5rem);

line-height:1.05;

letter-spacing:-2px;

margin-bottom:28px;

}

.hero h1 span{

color:#67E8F9;

}

.hero p{

font-size:1.15rem;

line-height:1.9;

color:#dbeafe;

max-width:650px;

}

.hero-buttons{

display:flex;

gap:20px;

margin-top:45px;

}

.hero-outline{

border:2px solid rgba(255,255,255,.25);

color:white;

}

.hero-outline:hover{

background:white;

color:#153E91;

}

.hero-stats{

display:flex;

gap:60px;

margin-top:70px;

}

.hero-stats h3{

font-size:2.5rem;

color:white;

}

.hero-stats p{

margin-top:8px;

font-size:.95rem;

color:#bfdbfe;

}

.feature-card{

background:white;

padding:45px;

border-radius:28px;

box-shadow:0 25px 70px rgba(0,0,0,.25);

}

.feature-card h2{

margin-bottom:30px;

font-size:2rem;

}

.feature-card ul{

list-style:none;

padding:0;

margin:0;

}

.feature-card li{

padding:18px 0;

border-bottom:1px solid #e5e7eb;

font-size:1.05rem;

}

.learn{

display:inline-block;

margin-top:30px;

font-weight:700;

text-decoration:none;

color:#2563eb;

}

@media(max-width:1000px){

.hero-grid{

grid-template-columns:1fr;

}

.hero-stats{

justify-content:space-between;

}

}

@media(max-width:700px){

.hero{

padding:80px 0;

}

.hero-buttons{

flex-direction:column;

}

.hero-stats{

flex-direction:column;

gap:25px;

}

.hero h1{

font-size:3rem;

}

}

</style>